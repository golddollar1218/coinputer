{
  "version": 3,
  "routes": [
    {
      "src": "^/_next/static/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/api/(.*)$",
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "no-store"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/(.+?)/?$",
      "dest": "/api/$1/index.html"
    }
  ]
}